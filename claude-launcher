#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(pwd)"

# Parse command line arguments
DRY_RUN=false
MODEL_NAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --model)
      MODEL_NAME="$2"
      shift 2
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      exit 1
      ;;
    *)
      # Positional argument - treat as model name
      MODEL_NAME="$1"
      shift
      ;;
  esac
done

get_ollama_models() {
  if ! command -v ollama >/dev/null 2>&1; then
    echo "Error: ollama is not installed or not in PATH." >&2
    exit 1
  fi

  mapfile -t models < <(
    ollama list |
      awk 'NR > 1 && tolower($1) ~ /claude/ {print $1}' |
      sort -u
  )
}

select_model() {
  local choice=""

  if command -v fzf >/dev/null 2>&1; then
    choice="$(
      printf '%s\n' "${models[@]}" |
        fzf --prompt='Select Claude model: '
    )"
  else
    echo "Available Claude models:"
    printf '  %s\n' "${models[@]}"
    read -rp "Enter model name: " choice
  fi

  if [[ -z "$choice" ]]; then
    echo "Error: no model selected." >&2
    exit 1
  fi

  if ! printf '%s\n' "${models[@]}" | grep -Fxq -- "$choice"; then
    echo "Error: '$choice' is not among the available Claude models." >&2
    exit 1
  fi

  SELECTED_MODEL="$choice"
}

# Use model name from command line if provided, otherwise select interactively
if [[ -n "$MODEL_NAME" ]]; then
  echo "Using model from command line: $MODEL_NAME"
  SELECTED_MODEL="$MODEL_NAME"
else
  get_ollama_models

  if [[ ${#models[@]} -eq 0 ]]; then
    echo "No Ollama models containing 'claude' were found." >&2
    exit 1
  fi

  select_model
fi

# Validate model exists in Ollama
validate_model() {
  if ! command -v ollama >/dev/null 2>&1; then
    echo "Error: ollama is not installed or not in PATH." >&2
    exit 1
  fi

  local available_models
  mapfile -t available_models < <(ollama list | awk 'NR > 1 {print $1}')

  if ! printf '%s\n' "${available_models[@]}" | grep -Fxq -- "$SELECTED_MODEL"; then
    echo "Error: Model '$SELECTED_MODEL' not found in Ollama." >&2
    echo "Available models:" >&2
    printf '  %s\n' "${available_models[@]}" >&2
    exit 1
  fi
}

validate_model

# Ensure claude-code is available on the host
if ! command -v claude >/dev/null 2>&1; then
  echo "Error: claude-code is not installed or not in PATH." >&2
  exit 1
fi

# Build the command as a single source of truth
CMD="env ANTHROPIC_BASE_URL=http://localhost:11435 \
    ANTHROPIC_AUTH_TOKEN=ollama \
    ANTHROPIC_API_KEY= \
    ANTHROPIC_DEFAULT_HAIKU_MODEL=\"${SELECTED_MODEL}\" \
    ANTHROPIC_DEFAULT_SONNET_MODEL=\"${SELECTED_MODEL}\" \
    ANTHROPIC_DEFAULT_OPUS_MODEL=\"${SELECTED_MODEL}\" \
    claude \"$@\""

# Print command if dry-run, otherwise execute it
if [[ "$DRY_RUN" == true ]]; then
  echo "$CMD"
else
  eval "$CMD"
fi
